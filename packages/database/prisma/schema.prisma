datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// Enums
// ----------------------------------------------------

enum RoleType {
  FARMER
  CONTRACTOR
  TRACTOR_OWNER
  SKILLED_WORKER
  EQUIPMENT_OWNER
  SUPPLIER
  // Future & Institutional roles (Section 14)
  DRIVER
  MECHANIC
  SERVICE_PROVIDER
  BUYER
  ADMIN
  FIELD_AGENT
  FPO
  COOPERATIVE
  GOVERNMENT
  NGO
  INSTITUTION
  FIELD_OFFICER
  TRANSPORT_PROVIDER
  LOGISTICS_OPERATOR
  // Milestone 21 Commerce Roles
  LOCAL_BUSINESS
  RETAILER
  TECHNICIAN
  REPAIR_SHOP
  ARTISAN
  SHOP_OWNER
  DELIVERY_PROVIDER
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  GOLD
  PLATINUM
}

enum ResourceType {
  TRACTOR
  WORKER
  EQUIPMENT
}

enum AvailabilityStatus {
  AVAILABLE
  BOOKED
  MAINTENANCE
  UNAVAILABLE
}

enum EquipmentType {
  SPRAYER
  PUMP
  WATER_PUMP
  AGRICULTURAL_MACHINE
  OTHER
}

enum LandType {
  IRRIGATED
  DRYLAND
  WETLAND
  MIXED
}

enum IrrigationType {
  BOREWELL
  CANAL
  DRIP
  SPRINKLER
  RAIN_FED
  OTHER
}

enum TractorCategory {
  COMPACT
  MEDIUM
  HEAVY
}

enum AttachmentType {
  ROTAVATOR
  CULTIVATOR
  PLOUGH
  SEED_DRILL
  TRAILER
  LEVELLER
  HARROW
  THRESHER
  SPRAYER
  OTHER
}

enum InputProductCategory {
  FERTILIZERS
  SEEDS
  CROP_PROTECTION
  MICRONUTRIENTS
  AGRICULTURAL_SUPPLIES
}

enum RequestStatus {
  OPEN
  MATCHED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  REQUESTED
  MATCHED
  QUOTED
  ACCEPTED
  SCHEDULED
  WORK_STARTED
  WORK_COMPLETED
  PAYMENT
  RATING
  CLOSED
  CANCELLED
  DISPUTED
  NO_SHOW
  RESCHEDULED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  UPI
  BANK_TRANSFER
  WALLET
  CASH
  CARD
}

enum CommunicationChannel {
  IN_APP
  SMS
  WHATSAPP
  IVR_AGENT
}

// ----------------------------------------------------
// 0. Location & Spatial Master
// ----------------------------------------------------

model Location {
  id        String   @id @default(uuid())
  village   String
  mandal    String
  district  String
  state     String   @default("Telangana")
  pincode   String?
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())

  farms                Farm[]
  projects             Project[]
  supplierProfiles     SupplierProfile[]
  equipment            Equipment[]
  workRequests         WorkRequest[]
  organizations        Organization[]
  programLocations     ProgramLocation[]
  procurementRequests  ProcurementRequest[]
  produceListings      ProduceListing[]
  produceAggregations  ProduceAggregation[]
  fulfillmentPickups   Fulfillment[]        @relation("FulfillmentPickupLocation")
  fulfillmentDeliveries Fulfillment[]       @relation("FulfillmentDeliveryLocation")
  vehiclesBased        Vehicle[]            @relation("VehicleBaseLocation")
  transportStops       TransportStop[]
  transportRequestsOrigin TransportRequest[] @relation("PickupLocation")
  transportRequestsDest   TransportRequest[] @relation("DeliveryLocation")
  jobPostings             JobPosting[]
  attendanceRecords       AttendanceRecord[]
  workerProfiles          WorkerProfile[]
  assetsBased             Asset[]              @relation("AssetBaseLocation")
  rentalRequestsLocation  RentalRequest[]      @relation("RentalRequestLocation")
  businessLocations       BusinessLocation[]
  businessProfiles        BusinessProfile[]
  serviceListingsLocation ServiceListing[]

  @@index([district, mandal, village])
  @@index([latitude, longitude])
}

// ----------------------------------------------------
// 1. Users, User Roles & Current Preferences (Sections 11 & 12)
// ----------------------------------------------------

model User {
  id                 String             @id @default(uuid())
  phone              String             @unique
  name               String
  email              String?            @unique
  status             String             @default("active") // active, suspended, pending
  profileImageUrl    String?
  verificationTier   Int                @default(0) // 0: Mobile, 1: Identity, 2: Document, 3: History, 4: Trusted
  rating             Float              @default(0.0)
  totalRatingsCount  Int                @default(0)
  disputeCount       Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Multi-Role & Preferences (User != Role)
  roles              UserRoleEntry[]
  preference         UserPreference?

  // Specific Persona Profiles
  farmerProfile      FarmerProfile?
  contractorProfile  ContractorProfile?
  tractorOwner       TractorOwnerProfile?
  skilledWorker      WorkerProfile?
  equipmentOwner     EquipmentOwnerProfile?
  supplierProfile    SupplierProfile?

  // Audits & Reviews
  reviewsGiven       Rating[]           @relation("ReviewsGiven")
  reviewsReceived    Rating[]           @relation("ReviewsReceived")
  communicationLogs  CommunicationLog[]

  // AI Subsystem (Milestone 13)
  aiConversations    AIConversation[]
  aiRecommendations  AIRecommendation[]
  aiFeedbacks        AIFeedback[]

  // Institutional Network (Milestone 14)
  organizationMemberships OrganizationMember[]
  createdOrganizations    Organization[]       @relation("CreatedOrganizations")
  createdPrograms         Program[]            @relation("CreatedPrograms")
  programParticipations   ProgramParticipant[]
  createdProcurements     ProcurementRequest[] @relation("CreatedProcurements")
  buyerProfile            BuyerProfile?

  // Logistics & Supply Chain (Milestone 15)
  driverProfile            DriverProfile?
  vehiclesOwned            Vehicle[]              @relation("OwnedVehicles")
  transportRequestsCreated TransportRequest[]     @relation("CustomerTransportRequests")
  transportOffersReceived  TransportOffer[]       @relation("ProviderTransportOffers")
  transportBookingsAsCust  TransportBooking[]     @relation("CustomerTransportBookings")
  deliveriesConfirmed      DeliveryConfirmation[] @relation("ConfirmedDeliveries")

  // Agricultural Marketplace & Commerce (Milestone 16)
  sellerProduceListings    ProduceListing[]       @relation("SellerProduceListings")
  buyerInterests           BuyerInterest[]        @relation("BuyerInterests")
  produceOffersMade        ProduceOffer[]         @relation("BuyerProduceOffers")
  produceOffersReceived    ProduceOffer[]         @relation("SellerProduceOffers")
  offerRevisions           OfferRevision[]        @relation("UserOfferRevisions")
  produceOrdersBought      ProduceOrder[]         @relation("BuyerProduceOrders")
  produceOrdersSold        ProduceOrder[]         @relation("SellerProduceOrders")
  inspectionsConducted     ProduceInspection[]    @relation("InspectedBy")
  qualityTestsConducted    ProduceQuality[]       @relation("QualityTestedBy")

  // Agricultural Knowledge, Advisory & Extension (Milestone 17)
  authoredArticles         KnowledgeArticle[]     @relation("AuthoredArticles")
  reviewedArticles         KnowledgeArticle[]     @relation("ReviewedArticles")
  articleReviews           KnowledgeReview[]      @relation("ReviewerReviews")
  articleVersions          KnowledgeArticleVersion[] @relation("VersionCreatedBy")
  advisoriesReceived       Advisory[]             @relation("UserAdvisories")
  fieldVisitsConducting    FieldVisit[]           @relation("OfficerFieldVisits")
  translationsReviewed     KnowledgeTranslation[] @relation("ReviewedTranslations")

  // Rural Financial Infrastructure & Credit Readiness (Milestone 18)
  financialProfile         FinancialProfile?
  incomeRecords            IncomeRecord[]
  expenseRecords           ExpenseRecord[]
  financialConsents        FinancialConsent[]
  creditProfile            CreditProfile?
  financingRequests        FinancingRequest[]

  // Rural Workforce, Jobs & Skill Marketplace (Milestone 19)
  createdJobPostings       JobPosting[]           @relation("CreatedJobPostings")
  createdJobOffers         JobOffer[]             @relation("CreatedJobOffers")

  // Rural Asset Rental, Equipment Sharing & Machinery Marketplace (Milestone 20)
  ownedAssets              Asset[]                @relation("UserOwnedAssets")
  rentalListings           RentalListing[]        @relation("UserRentalListings")
  rentalRequests           RentalRequest[]        @relation("UserRentalRequests")
  rentalOffersReceived     RentalOffer[]          @relation("ProviderRentalOffers")
  rentalBookingsAsOwner    RentalBooking[]        @relation("OwnerRentalBookings")
  rentalBookingsAsRenter   RentalBooking[]        @relation("RenterRentalBookings")
  assetHandoversGiven      AssetHandover[]        @relation("HandoverGiver")
  assetHandoversReceived   AssetHandover[]        @relation("HandoverReceiver")
  assetInspectionsConducted AssetInspection[]     @relation("AssetInspectedBy")

  // Rural Commerce & Local Business Marketplace (Milestone 21)
  ownedBusinesses          BusinessProfile[]      @relation("BusinessOwner")
  buyerEnquiries           ProductEnquiry[]       @relation("BuyerEnquiries")
  buyerCommerceQuotes      CommerceQuote[]        @relation("BuyerCommerceQuotes")
  buyerCommerceOrders      CommerceOrder[]        @relation("BuyerCommerceOrders")

  // Rural Identity, Wallet & Unified Transaction Layer (Milestone 22)
  walletAccounts           WalletAccount[]
  payoutDestinations       PayoutDestination[]
  payerTransactions        FinancialTransaction[] @relation("PayerTransactions")
  payeeTransactions        FinancialTransaction[] @relation("PayeeTransactions")
  providerEarnings         ProviderEarning[]
  settlements              Settlement[]
  withdrawalRequests       WithdrawalRequest[]

  // Rural Data Platform, Interoperability & Open Platform (Milestone 23)
  apiClients               ApiClient[]
  webhookSubscriptions     WebhookSubscription[]
  dataExportJobs           DataExportJob[]        @relation("UserExportJobs")
  syncOperations           SyncOperation[]
  dataConsents             DataConsent[]          @relation("UserDataConsents")
  platformDevices          PlatformDevice[]
}

model UserRoleEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      RoleType
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, role])
  @@index([userId])
  @@index([role])
}

model UserPreference {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentRole       RoleType @default(FARMER)
  preferredLanguage String   @default("Telugu")
  theme             String   @default("light")
  updatedAt         DateTime @updatedAt
}

// ----------------------------------------------------
// 2. Farmer Database & Farms (Section 13)
// ----------------------------------------------------

model FarmerProfile {
  id                String          @id @default(uuid())
  userId            String          @unique
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredLanguage String          @default("Telugu")
  experienceYears   Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  farms             Farm[]
}

model Farm {
  id             String         @id @default(uuid())
  farmerId       String
  farmer         FarmerProfile  @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  name           String         // e.g. "North Field", "Village Borewell Plot"
  area           Float          // e.g. 4.0
  areaUnit       String         @default("acres")
  locationId     String
  location       Location       @relation(fields: [locationId], references: [id])
  crop           String         // e.g. "Cotton", "Paddy"
  irrigationType IrrigationType @default(BOREWELL)
  landType       LandType       @default(IRRIGATED)
  surveyNumber   String?
  createdAt      DateTime       @default(now())

  organizationFarms  OrganizationFarm[]
  produceListings    ProduceListing[]
  advisories         Advisory[]
  fieldVisits        FieldVisit[]
  cropKnowledgeLinks CropKnowledge[]
  financialPeriods   FarmFinancialPeriod[]
  jobPostings        JobPosting[]

  @@index([farmerId])
  @@index([locationId])
}

// ----------------------------------------------------
// 3. Contractor Database & Projects (Section 14)
// ----------------------------------------------------

model ContractorProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String             // e.g. "Sri Sai Agri Contracting"
  experienceYears    Int                @default(0)
  serviceRadius      Float              @default(25.0) // km
  description        String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  rating             Float              @default(0.0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  projects           Project[]
}

model Project {
  id                    String                         @id @default(uuid())
  contractorId          String?
  contractor            ContractorProfile?             @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  organizationId        String?
  organization          Organization?                  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  programId             String?
  program               Program?                       @relation(fields: [programId], references: [id], onDelete: SetNull)
  title                 String                         // e.g. "Village X agricultural operation"
  description           String?
  locationId            String
  location              Location                       @relation(fields: [locationId], references: [id])
  totalAcreage          Float                          @default(50.0)
  startDate             DateTime
  endDate               DateTime
  status                String                         @default("open") // open, in_progress, completed, cancelled
  fulfillmentPercentage Float                          @default(0.0)
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  requirements          ProjectRequirement[]
  jobPostings           JobPosting[]

  @@index([contractorId])
  @@index([organizationId])
  @@index([programId])
  @@index([locationId])
  @@index([status])
}

model ProjectRequirement {
  id                String   @id @default(uuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category          String   // "tractor", "worker", "sprayer", "equipment"
  specName          String   // e.g. "50 HP Tractor", "Sprayer Operator"
  quantityRequired  Int      @default(1)
  quantityFulfilled Int      @default(0)
  unitRateBudget    Float    @default(0.0)

  @@index([projectId])
}

// ----------------------------------------------------
// 4. Tractor Owner, Tractors & Attachments (Sections 15 & 16)
// ----------------------------------------------------

model TractorOwnerProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  rating             Float              @default(0.0)
  completedJobs      Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tractors           Tractor[]
}

model Tractor {
  id                 String              @id @default(uuid())
  ownerId            String
  owner              TractorOwnerProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  registrationNumber String?             @unique // e.g. "TS34AB1234"
  brand              String?             // e.g. "Mahindra", "John Deere", "Swaraj"
  model              String?             // e.g. "Arjun 550 DI"
  hp                 Int?                // e.g. 50, 45, 35
  manufacturingYear  Int?                // purchase / manufacturing year
  year               Int?                // alias for manufacturing year
  condition          String?             @default("good") // excellent, good, fair
  verificationStatus VerificationStatus  @default(UNVERIFIED)
  status             String              @default("ACTIVE") // ACTIVE, maintenance, retired
  baseRatePerAcre    Float?              @default(950.0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  attachments        TractorAttachment[]

  @@index([ownerId])
  @@index([hp])
}

model TractorAttachment {
  id             String         @id @default(uuid())
  tractorId      String
  tractor        Tractor        @relation(fields: [tractorId], references: [id], onDelete: Cascade)
  attachmentType AttachmentType // ROTAVATOR, CULTIVATOR, PLOUGH, TRAILER, SEED_DRILL
  brand          String?
  condition      String?        @default("good")
  status         String         @default("ACTIVE")
  perAcreRate    Float?         @default(350.0)
  createdAt      DateTime       @default(now())

  @@index([tractorId])
  @@index([attachmentType])
}

// ----------------------------------------------------
// 5. Skilled Workers, Skills & Worker Skills (Section 17)
// ----------------------------------------------------

model WorkerProfile {
  id                 String                   @id @default(uuid())
  userId             String                   @unique
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseLocationId     String?
  baseLocation       Location?                @relation(fields: [baseLocationId], references: [id])
  experienceYears    Int?                     @default(0)
  serviceRadiusKm    Float?                   @default(10.0) // km
  serviceRadius      Float?                   @default(10.0) // km (backward compatibility alias)
  expectedDailyRate  Float?                   @default(550.0) // INR
  dailyRate          Float?                   @default(550.0) // INR (backward compatibility alias)
  expectedHourlyRate Float?                   @default(80.0)
  employmentType     EmploymentType           @default(DAILY_WAGE)
  availabilityStatus WorkerAvailabilityStatus @default(AVAILABLE)
  verificationStatus VerificationStatus       @default(UNVERIFIED)
  rating             Float                    @default(0.0)
  completedJobs      Int                      @default(0)
  bio                String?                  @db.Text
  status             String                   @default("ACTIVE")
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  skills             WorkerSkill[]
  certifications     WorkerCertification[]
  experienceLedger   WorkerExperience[]
  jobApplications    JobApplication[]
  jobOffers          JobOffer[]
  jobAssignments     JobAssignment[]
  attendanceRecords  AttendanceRecord[]
  workHistories      WorkerWorkHistory[]
}

model Skill {
  id              String           @id @default(uuid())
  name            String           @unique // e.g. "Tractor Operator", "Sprayer Operator", "Pump Technician"
  category        String           // e.g. "Machinery Operation", "Crop Care", "Irrigation"

  workers         WorkerSkill[]
  jobRequirements JobRequirement[]
}

model WorkerSkill {
  id              String        @id @default(uuid())
  workerId        String
  worker          WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  skillId         String
  skill           Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillLevel      SkillLevel    @default(INTERMEDIATE)
  yearsExperience Int?          @default(1)
  experienceYears Int?          @default(1) // alias for backward compatibility
  isPrimary       Boolean       @default(false)
  verified        Boolean       @default(false)
  verifiedAt      DateTime?

  @@unique([workerId, skillId])
  @@index([workerId])
  @@index([skillId])
}

// ----------------------------------------------------
// 6. Generic Equipment & Equipment Owners (Section 18)
// ----------------------------------------------------

model EquipmentOwnerProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  experienceYears    Int?               @default(0)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  rating             Float              @default(0.0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  equipment          Equipment[]
}

model Equipment {
  id               String                @id @default(uuid())
  ownerId          String
  owner            EquipmentOwnerProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type             EquipmentType         @default(OTHER) // SPRAYER, PUMP, WATER_PUMP, OTHER
  equipmentType    EquipmentType         @default(OTHER)
  brand            String?               // e.g. "Aspee", "Kirloskar", "Neptune"
  model            String?               // e.g. "HTP-35", "BS-16"
  capacity         String?               // e.g. "35 LPM", "7.5 HP", "16 Litres"
  condition        String?               @default("good")
  locationId       String?
  location         Location?             @relation(fields: [locationId], references: [id])
  rentalRatePerDay Float?                @default(1200.0)
  status           String                @default("ACTIVE")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([ownerId])
  @@index([equipmentType])
}

// ----------------------------------------------------
// 7. Supplier & Products (Section 19)
// ----------------------------------------------------

model SupplierProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String             // e.g. "Sri Venkateshwara Agri Inputs"
  shopName           String
  locationId         String
  location           Location           @relation(fields: [locationId], references: [id])
  fertilizerLicense  String?
  seedLicense        String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  products           Product[]
  quotes             SupplierQuote[]

  @@index([locationId])
}

model Product {
  id          String               @id @default(uuid())
  supplierId  String
  supplier    SupplierProfile      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name        String               // e.g. "Urea (Neem Coated)", "Cotton Seed Hybrid"
  category    InputProductCategory
  unit        String               // "50 kg bag", "1 Litre bottle"
  price       Float                // e.g. 266.50
  stockStatus String               @default("in_stock") // in_stock, low_stock, out_of_stock
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([supplierId])
  @@index([category])
}

// ----------------------------------------------------
// 8. Unified Common Availability Engine (Section 20)
// ----------------------------------------------------

model Availability {
  id           String             @id @default(uuid())
  resourceType ResourceType       // TRACTOR, WORKER, EQUIPMENT
  resourceId   String             // ID of Tractor, WorkerProfile, or Equipment
  date         DateTime           // Date of availability slot
  startTime    String             @default("07:00")
  endTime      String             @default("17:00")
  status       AvailabilityStatus @default(AVAILABLE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([resourceType, resourceId])
  @@index([date, status])
}

// ----------------------------------------------------
// 9. Work Requests, Work Requirements & Bookings (Sections 21–25)
// ----------------------------------------------------

model WorkRequest {
  id            String            @id @default(uuid())
  referenceCode String            @unique // e.g. "TRW-000124", "REQ-1001"
  createdBy     String
  requestType   String            // "TRACTOR_WORK", "SKILLED_WORKER", "SPRAY_PUMP", "CONTRACTOR_WORK"
  locationId    String
  location      Location          @relation(fields: [locationId], references: [id])
  requestedDate DateTime
  startTime     String            @default("07:00")
  endTime       String            @default("17:00")
  status        RequestStatus     @default(OPEN)
  description   String?
  createdAt     DateTime          @default(now())

  requirements  WorkRequirement[]
  bookings      Booking[]

  @@index([status])
  @@index([referenceCode])
  @@index([locationId])
}

model WorkRequirement {
  id             String          @id @default(uuid())
  requestId      String
  request        WorkRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  resourceType   ResourceType    // TRACTOR, WORKER, EQUIPMENT
  quantity       Int             @default(1)
  skillId        String?
  equipmentType  EquipmentType?
  tractorHpMin   Int?            // e.g. 45 HP
  attachmentType AttachmentType? // e.g. ROTAVATOR, PLOUGH

  @@index([requestId])
}

model Booking {
  id            String        @id @default(uuid())
  referenceCode String        @unique // e.g. "BKG-000124"
  requestId     String?
  request       WorkRequest?  @relation(fields: [requestId], references: [id])
  providerId    String        // User ID or Profile ID of provider
  providerType  RoleType      // TRACTOR_OWNER, SKILLED_WORKER, EQUIPMENT_OWNER, CONTRACTOR
  customerId    String        // User ID of customer (Farmer or Contractor)
  customerType  RoleType      // FARMER, CONTRACTOR
  scheduledDate DateTime
  startTime     String        @default("07:00")
  endTime       String        @default("17:00")
  agreedPrice   Float         // Total agreed price INR
  status        BookingStatus @default(REQUESTED) // REQUESTED, SCHEDULED, ARRIVED, WORK_STARTED, WORK_COMPLETED, CONFIRMED
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  payment       Payment?
  rating        Rating?
  workSessions  WorkSession[]
  disputes      Dispute[]

  @@index([providerId])
  @@index([customerId])
  @@index([status])
}

model WorkSession {
  id           String    @id @default(uuid())
  bookingId    String
  booking      Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  actualHours  Float?
  actualArea   Float?    // acres
  notes        String?
  status       String    @default("started") // started, completed, confirmed

  @@index([bookingId])
}

model Payment {
  id            String        @id @default(uuid())
  bookingId     String        @unique
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount        Float
  status        PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod @default(UPI)
  transactionId String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Rating {
  id         String   @id @default(uuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User     @relation("ReviewsGiven", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User     @relation("ReviewsReceived", fields: [toUserId], references: [id])
  rating     Float    // e.g. 4.7
  review     String?  // Review comment
  createdAt  DateTime @default(now())

  @@index([fromUserId])
  @@index([toUserId])
}

model Dispute {
  id             String    @id @default(uuid())
  bookingId      String
  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  raisedByUserId String
  reason         String    // "no_show", "incomplete_work", "rate_dispute"
  description    String
  status         String    @default("open")
  refundAmount   Float?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([bookingId])
}

model CommunicationLog {
  id             String               @id @default(uuid())
  recipientId    String
  recipient      User                 @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  channel        CommunicationChannel @default(SMS)
  title          String
  body           String
  referenceCode  String?
  timestamp      DateTime             @default(now())

  @@index([recipientId])
}

// ----------------------------------------------------
// 13. AI Intelligence & Assistant Subsystem (Milestone 13)
// ----------------------------------------------------

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum AIRecommendationType {
  FARM_ACTIVITY
  RESOURCE
  PRICE
  SUPPLIER
  DEMAND
  SUPPLY
  INVENTORY
}

enum AIRecommendationStatus {
  GENERATED
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum AIConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

model AIConversation {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  contextType String?
  contextId   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  messages    AIMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AIMessageRole  @default(USER)
  content        String
  metadata       Json?
  createdAt      DateTime       @default(now())

  @@index([conversationId])
  @@map("ai_messages")
}

model AIRecommendation {
  id            String                 @id @default(uuid())
  userId        String
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          AIRecommendationType
  referenceType String?
  referenceId   String?
  title         String
  description   String
  confidence    AIConfidenceLevel      @default(MEDIUM)
  status        AIRecommendationStatus @default(GENERATED)
  metadata      Json?
  createdAt     DateTime               @default(now())
  expiresAt     DateTime?
  feedbacks     AIFeedback[]

  @@index([userId])
  @@index([type])
  @@map("ai_recommendations")
}

model AIFeedback {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendationId String
  recommendation   AIRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  rating           String // "UPVOTE", "DOWNVOTE", "USEFUL", "NOT_USEFUL"
  feedback         String?
  createdAt        DateTime         @default(now())

  @@index([userId])
  @@index([recommendationId])
  @@map("ai_feedbacks")
}

// ----------------------------------------------------
// 14. Government, FPO, Cooperative & Institutional Network (Milestone 14)
// ----------------------------------------------------

enum OrganizationType {
  FPO
  COOPERATIVE
  GOVERNMENT
  NGO
  INSTITUTION
  CUSTOM
}

enum OrgMembershipRole {
  ADMIN
  MANAGER
  FIELD_OFFICER
  MEMBER
  OBSERVER
}

enum OrgFarmRelationship {
  OWNED
  MEMBER_FARM
  PROGRAM_ATTACHED
}

enum ProgramType {
  GOVERNMENT_SUBSIDY
  FPO_SCHEME
  NGO_INITIATIVE
  SEASONAL_DRIVE
  EQUIPMENT_MECHANIZATION
}

enum ProgramStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ProgramCoverageType {
  STATE
  DISTRICT
  MANDAL
  VILLAGE
}

enum ProcurementStatus {
  DRAFT
  OPEN
  QUOTED
  AWARDED
  IN_PROGRESS
  FULFILLED
  CANCELLED
}

enum SupplierQuoteStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  EXPIRED
}

enum BuyerType {
  INSTITUTIONAL
  AGGREGATOR
  FOOD_PROCESSOR
  EXPORTER
  RETAIL_CHAIN
}

enum ProduceListingStatus {
  DRAFT
  AVAILABLE
  PARTIALLY_COMMITTED
  COMMITTED
  SOLD
  EXPIRED
  CANCELLED
}

enum BuyerInterestStatus {
  ACTIVE
  WITHDRAWN
  RESPONDED
  EXPIRED
  CONVERTED
}

enum ProduceOfferStatus {
  DRAFT
  SUBMITTED
  COUNTERED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum ProduceOrderStatus {
  CONFIRMED
  FULFILLMENT_PENDING
  READY_FOR_PICKUP
  IN_TRANSIT
  DELIVERED
  ACCEPTED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum QualityVerificationTier {
  SELF_DECLARED
  SELLER_VERIFIED
  THIRD_PARTY_VERIFIED
  BUYER_VERIFIED
}

enum InspectionType {
  PRE_ORDER
  PRE_DISPATCH
  DELIVERY
  POST_DELIVERY
}

enum InspectionStatus {
  PENDING
  PASSED
  FAILED
  CONDITIONAL
}

enum FulfillmentStatus {
  PENDING
  READY
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum AggregationStatus {
  DRAFT
  AVAILABLE
  COMMITTED
  SOLD
  DISBANDED
}

model Organization {
  id                  String               @id @default(uuid())
  name                String               // e.g. "Kalyandurg Farmer Producer Co. Ltd."
  code                String               @unique // e.g. "FPO-KD-001"
  type                OrganizationType     @default(FPO)
  registrationNumber  String?              // CIN/Govt Reg number
  description         String?
  primaryContactPhone String?
  primaryContactEmail String?
  locationId          String
  location            Location             @relation(fields: [locationId], references: [id])
  createdById         String
  creator             User                 @relation("CreatedOrganizations", fields: [createdById], references: [id])
  status              String               @default("active") // active, suspended, pending
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  members             OrganizationMember[]
  farms               OrganizationFarm[]
  programs            Program[]
  projects            Project[]
  procurements        ProcurementRequest[]
  produceListings     ProduceListing[]
  produceAggregations ProduceAggregation[]
  vehicles            Vehicle[]
  transportRequests   TransportRequest[]
  jobPostings         JobPosting[]
  assets              Asset[]              @relation("OrganizationAssets")
  assetAccessPolicies AssetAccessPolicy[]
  businesses          BusinessProfile[]

  // Rural Data Platform, Interoperability & Open Platform (Milestone 23)
  apiClients          ApiClient[]
  webhookSubscriptions WebhookSubscription[]
  integrations        Integration[]
  dataExportJobs      DataExportJob[]        @relation("OrgExportJobs")
  dataConsents        DataConsent[]          @relation("OrgDataConsents")

  @@index([type])
  @@index([locationId])
  @@index([code])
}

model OrganizationMember {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrgMembershipRole @default(MEMBER)
  joinedAt       DateTime          @default(now())
  status         String            @default("active") // active, inactive, pending_approval
  permissions    Json?             // Granular RBAC permissions overrides

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([role])
}

model OrganizationFarm {
  id             String              @id @default(uuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farmId         String
  farm           Farm                @relation(fields: [farmId], references: [id], onDelete: Cascade)
  relationship   OrgFarmRelationship @default(MEMBER_FARM)
  attachedAt     DateTime            @default(now())

  @@unique([organizationId, farmId])
  @@index([organizationId])
  @@index([farmId])
}

model Program {
  id             String               @id @default(uuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String               @unique // e.g. "PRG-TEL-2026-FARM-MECH"
  name           String               // e.g. "Rythu Bandhu Mechanization & Spraying Drive"
  description    String?
  type           ProgramType          @default(GOVERNMENT_SUBSIDY)
  status         ProgramStatus        @default(ACTIVE)
  budgetTotal    Float                @default(0.0) // Budget allocation in INR
  budgetSpent    Float                @default(0.0)
  subsidyRate    Float                @default(0.0) // percentage e.g. 50.0%
  startDate      DateTime
  endDate        DateTime
  createdById    String
  creator        User                 @relation("CreatedPrograms", fields: [createdById], references: [id])
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  locations      ProgramLocation[]
  participants   ProgramParticipant[]
  projects       Project[]

  @@index([organizationId])
  @@index([status])
  @@index([type])
}

model ProgramLocation {
  id           String              @id @default(uuid())
  programId    String
  program      Program             @relation(fields: [programId], references: [id], onDelete: Cascade)
  locationId   String
  location     Location            @relation(fields: [locationId], references: [id])
  coverageType ProgramCoverageType @default(MANDAL)

  @@unique([programId, locationId])
  @@index([programId])
  @@index([locationId])
}

model ProgramParticipant {
  id            String    @id @default(uuid())
  programId     String
  program       Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrolledAt    DateTime  @default(now())
  subsidyClaimed Float    @default(0.0)
  status        String    @default("enrolled") // enrolled, approved, rejected, completed

  @@unique([programId, userId])
  @@index([programId])
  @@index([userId])
}

model ProcurementRequest {
  id              String                   @id @default(uuid())
  code            String                   @unique // e.g. "PROC-2026-0042"
  organizationId  String
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title           String                   // e.g. "Bulk Monsoon Fertilizer Supply (1200 Bags Urea + DAP)"
  description     String?
  targetBudget    Float                    @default(0.0)
  deliveryLocationId String
  deliveryLocation Location                @relation(fields: [deliveryLocationId], references: [id])
  status          ProcurementStatus        @default(OPEN)
  biddingDeadline DateTime
  createdById     String
  creator         User                     @relation("CreatedProcurements", fields: [createdById], references: [id])
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  requirements    ProcurementRequirement[]
  quotes          SupplierQuote[]

  @@index([organizationId])
  @@index([status])
  @@index([deliveryLocationId])
}

model ProcurementRequirement {
  id            String             @id @default(uuid())
  procurementId String
  procurement   ProcurementRequest @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  itemCategory  String             // "FERTILIZER", "SEED", "PESTICIDE", "EQUIPMENT", "CUSTOM"
  itemName      String             // "Neem Coated Urea (50kg)"
  quantity      Float              // 1200
  unit          String             // "bags", "litres", "units"
  specifications String?

  @@index([procurementId])
}

model SupplierQuote {
  id             String              @id @default(uuid())
  procurementId  String
  procurement    ProcurementRequest  @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       SupplierProfile     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  quoteAmount    Float               // Total quote in INR
  deliveryDays   Int                 @default(3) // Delivery within N days
  notes          String?
  status         SupplierQuoteStatus @default(SUBMITTED)
  validUntil     DateTime
  submittedAt    DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([procurementId])
  @@index([supplierId])
  @@index([status])
}

model BuyerProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName        String             // e.g. "Deccan Agri Aggregators Pvt Ltd"
  buyerType          BuyerType          @default(AGGREGATOR)
  gstNumber          String?
  contactPhone       String?
  contactEmail       String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  tradingVolume      Float              @default(0.0)
  rating             Float              @default(0.0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([buyerType])
  @@index([verificationStatus])
}

model ProduceListing {
  id                  String               @id @default(uuid())
  code                String               @unique // e.g. "PRD-2026-0089"
  sellerId            String?
  seller              User?                @relation("SellerProduceListings", fields: [sellerId], references: [id], onDelete: SetNull)
  organizationId      String?
  organization        Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  farmId              String?
  farm                Farm?                @relation(fields: [farmId], references: [id], onDelete: SetNull)
  cropName            String               // "Cotton", "Paddy", "Red Chilli", "Groundnut"
  cropVariety         String?              // "Brahma 32mm", "BPT 5204", "Kadiri-6"
  quantity            Float                // Total listed quantity
  availableQuantity   Float                // Available for commitment
  unit                String               @default("Quintals")
  expectedHarvestDate DateTime?
  harvestDate         DateTime?
  qualityGrade        String?              // "Grade A", "Export Quality", "Standard"
  locationId          String
  location            Location             @relation(fields: [locationId], references: [id])
  askingPrice         Float?               // Optional asking price in INR
  priceUnit           String?              @default("INR/Quintal")
  description         String?
  status              ProduceListingStatus @default(AVAILABLE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  interests           BuyerInterest[]
  offers              ProduceOffer[]
  orderItems          OrderItem[]
  qualities           ProduceQuality[]
  aggregationItems    ProduceAggregationItem[]

  @@index([sellerId])
  @@index([organizationId])
  @@index([farmId])
  @@index([locationId])
  @@index([cropName])
  @@index([qualityGrade])
  @@index([status])
  @@index([askingPrice])
}

model BuyerInterest {
  id               String              @id @default(uuid())
  buyerId          String
  buyer            User                @relation("BuyerInterests", fields: [buyerId], references: [id], onDelete: Cascade)
  produceListingId String
  produceListing   ProduceListing      @relation(fields: [produceListingId], references: [id], onDelete: Cascade)
  quantity         Float
  message          String?
  status           BuyerInterestStatus @default(ACTIVE)
  expiresAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([buyerId])
  @@index([produceListingId])
  @@index([status])
}

model ProduceOffer {
  id               String             @id @default(uuid())
  buyerId          String
  buyer            User               @relation("BuyerProduceOffers", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId         String
  seller           User               @relation("SellerProduceOffers", fields: [sellerId], references: [id], onDelete: Cascade)
  produceListingId String
  produceListing   ProduceListing     @relation(fields: [produceListingId], references: [id], onDelete: Cascade)
  quantity         Float
  unitPrice        Float
  currency         String             @default("INR")
  totalAmount      Float
  message          String?
  validUntil       DateTime
  status           ProduceOfferStatus @default(SUBMITTED)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  revisions        OfferRevision[]
  order            ProduceOrder?

  @@index([buyerId])
  @@index([sellerId])
  @@index([produceListingId])
  @@index([status])
}

model OfferRevision {
  id          String       @id @default(uuid())
  offerId     String
  offer       ProduceOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User         @relation("UserOfferRevisions", fields: [createdById], references: [id], onDelete: Cascade)
  quantity    Float
  unitPrice   Float
  message     String?
  createdAt   DateTime     @default(now())

  @@index([offerId])
  @@index([createdById])
}

model ProduceOrder {
  id            String             @id @default(uuid())
  orderNumber   String             @unique // e.g. "ORD-2026-9021"
  buyerId       String
  buyer         User               @relation("BuyerProduceOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId      String
  seller        User               @relation("SellerProduceOrders", fields: [sellerId], references: [id], onDelete: Cascade)
  offerId       String?            @unique
  offer         ProduceOffer?      @relation(fields: [offerId], references: [id], onDelete: SetNull)
  subtotal      Float
  transportCost Float              @default(0.0)
  tax           Float              @default(0.0)
  discount      Float              @default(0.0)
  total         Float
  currency      String             @default("INR")
  status        ProduceOrderStatus @default(CONFIRMED)
  orderedAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  orderItems    OrderItem[]
  fulfillments  Fulfillment[]
  inspections   ProduceInspection[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

model OrderItem {
  id               String         @id @default(uuid())
  orderId          String
  order            ProduceOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  produceListingId String
  produceListing   ProduceListing @relation(fields: [produceListingId], references: [id], onDelete: Cascade)
  quantity         Float
  unit             String         @default("Quintals")
  unitPrice        Float
  totalAmount      Float

  @@index([orderId])
  @@index([produceListingId])
}

model ProduceQuality {
  id               String                  @id @default(uuid())
  produceListingId String
  produceListing   ProduceListing          @relation(fields: [produceListingId], references: [id], onDelete: Cascade)
  grade            String                  // "Grade A", "Export Quality"
  verificationTier QualityVerificationTier @default(SELF_DECLARED)
  testedAt         DateTime?
  testedById       String?
  testedBy         User?                   @relation("QualityTestedBy", fields: [testedById], references: [id], onDelete: SetNull)
  notes            String?
  createdAt        DateTime                @default(now())

  attributes       QualityAttribute[]

  @@index([produceListingId])
  @@index([verificationTier])
}

model QualityAttribute {
  id               String         @id @default(uuid())
  produceQualityId String
  produceQuality   ProduceQuality @relation(fields: [produceQualityId], references: [id], onDelete: Cascade)
  attribute        String         // "Moisture", "Foreign Matter", "Staple Length", "Oil Content"
  value            String         // "7.5", "1.2", "32mm", "44%"
  unit             String?        // "%", "mm"

  @@index([produceQualityId])
}

model ProduceInspection {
  id            String            @id @default(uuid())
  orderId       String
  order         ProduceOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inspectedById String
  inspectedBy   User              @relation("InspectedBy", fields: [inspectedById], references: [id], onDelete: Cascade)
  inspectionType InspectionType   @default(PRE_DISPATCH)
  status        InspectionStatus  @default(PENDING)
  notes         String?
  inspectedAt   DateTime          @default(now())

  @@index([orderId])
  @@index([inspectedById])
  @@index([status])
}

model Fulfillment {
  id                 String            @id @default(uuid())
  orderId            String
  order              ProduceOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pickupLocationId   String
  pickupLocation     Location          @relation("FulfillmentPickupLocation", fields: [pickupLocationId], references: [id])
  deliveryLocationId String
  deliveryLocation   Location          @relation("FulfillmentDeliveryLocation", fields: [deliveryLocationId], references: [id])
  plannedPickupDate  DateTime?
  plannedDeliveryDate DateTime?
  quantity           Float
  unit               String            @default("Quintals")
  status             FulfillmentStatus @default(PENDING)
  transportRequestId String?
  transportRequest   TransportRequest? @relation(fields: [transportRequestId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([orderId])
  @@index([transportRequestId])
  @@index([status])
  @@index([pickupLocationId])
  @@index([deliveryLocationId])
}

model ProduceAggregation {
  id                String             @id @default(uuid())
  code              String             @unique // e.g. "AGG-2026-COT-01"
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cropName          String             // "Cotton (Long Staple)"
  cropVariety       String?            // "Brahma 32mm"
  totalQuantity     Float              // Sum of attached listings
  availableQuantity Float
  unit              String             @default("Quintals")
  qualityGrade      String?            // "Grade A"
  locationId        String
  location          Location           @relation(fields: [locationId], references: [id])
  status            AggregationStatus  @default(AVAILABLE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  items             ProduceAggregationItem[]

  @@index([organizationId])
  @@index([locationId])
  @@index([cropName])
  @@index([status])
}

model ProduceAggregationItem {
  id               String             @id @default(uuid())
  aggregationId    String
  aggregation      ProduceAggregation @relation(fields: [aggregationId], references: [id], onDelete: Cascade)
  produceListingId String
  produceListing   ProduceListing     @relation(fields: [produceListingId], references: [id], onDelete: Cascade)
  quantity         Float
  attachedAt       DateTime           @default(now())

  @@index([aggregationId])
  @@index([produceListingId])
}

// ----------------------------------------------------
// 15. Logistics, Transportation & Agricultural Supply Chain (Milestone 15)
// ----------------------------------------------------

enum VehicleType {
  TRACTOR
  TRACTOR_TRAILER
  MINI_TRUCK
  TRUCK
  PICKUP
  TANKER
  TEMPO
  OTHER
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  SUSPENDED
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TransportRequestType {
  INPUT_DELIVERY
  PRODUCE_TRANSPORT
  EQUIPMENT_TRANSPORT
  WATER_TRANSPORT
  PERSON_TRANSPORT
  GENERAL_CARGO
  OTHER
}

enum TransportStopType {
  PICKUP
  DELIVERY
  WAYPOINT
}

enum TransportOfferStatus {
  OFFERED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum TransportBookingStatus {
  CONFIRMED
  DRIVER_ASSIGNED
  VEHICLE_ASSIGNED
  READY
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum TripStatus {
  PLANNED
  STARTED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum DeliveryEvidenceType {
  PHOTO
  DOCUMENT
  SIGNATURE
  OTP
}

model Vehicle {
  id                 String             @id @default(uuid())
  ownerId            String
  owner              User               @relation("OwnedVehicles", fields: [ownerId], references: [id], onDelete: Cascade)
  organizationId     String?
  organization       Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  vehicleType        VehicleType        @default(MINI_TRUCK)
  registrationNumber String             @unique // e.g. "TS-08-UB-4821"
  brand              String             // e.g. "Mahindra", "Eicher", "Tata"
  model              String             // e.g. "Bolero Maxi Truck", "Pro 2049", "575 DI + 5T Trailer"
  manufacturingYear  Int?
  capacity           Float              // Maximum payload capacity
  capacityUnit       String             @default("kg") // "kg", "quintals", "tonnes", "litres"
  condition          String             @default("good")
  status             VehicleStatus      @default(ACTIVE)
  baseLocationId     String
  baseLocation       Location           @relation("VehicleBaseLocation", fields: [baseLocationId], references: [id])
  serviceRadiusKm    Float              @default(35.0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  vehicleDrivers     VehicleDriver[]
  transportOffers    TransportOffer[]
  transportBookings  TransportBooking[]

  @@index([ownerId])
  @@index([organizationId])
  @@index([vehicleType])
  @@index([status])
  @@index([baseLocationId])
}

model DriverProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseType        String             // "LMV_COMMERCIAL", "HMV_HEAVY", "TRACTOR_TRAILER"
  licenseNumber      String             @unique // e.g. "DL-TS-2024-884912"
  licenseExpiry      DateTime
  experienceYears    Int                @default(0)
  serviceRadiusKm    Float              @default(30.0)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  rating             Float              @default(0.0)
  status             DriverStatus       @default(ACTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  vehicleDrivers     VehicleDriver[]
  transportOffers    TransportOffer[]
  transportBookings  TransportBooking[]

  @@index([licenseType])
  @@index([status])
  @@index([verificationStatus])
}

model VehicleDriver {
  id          String        @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId    String
  driver      DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)
  isPrimary   Boolean       @default(true)
  validFrom   DateTime      @default(now())
  validUntil  DateTime?
  createdAt   DateTime      @default(now())

  @@unique([vehicleId, driverId])
  @@index([vehicleId])
  @@index([driverId])
}

model TransportRequest {
  id                 String                 @id @default(uuid())
  code               String                 @unique // e.g. "TRQ-2026-0001"
  createdById        String
  creator            User                   @relation("CustomerTransportRequests", fields: [createdById], references: [id], onDelete: Cascade)
  organizationId     String?
  organization       Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  requestType        TransportRequestType   @default(PRODUCE_TRANSPORT)
  pickupLocationId   String
  pickupLocation     Location               @relation("PickupLocation", fields: [pickupLocationId], references: [id])
  deliveryLocationId String
  deliveryLocation   Location               @relation("DeliveryLocation", fields: [deliveryLocationId], references: [id])
  requestedDate      DateTime
  pickupStartTime    String                 @default("07:00")
  pickupEndTime      String                 @default("17:00")
  description        String?
  status             String                 @default("OPEN") // OPEN, MATCHED, IN_TRANSIT, DELIVERED, CANCELLED
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  requirements       TransportRequirement[]
  stops              TransportStop[]
  offers             TransportOffer[]
  bookings           TransportBooking[]
  fulfillments       Fulfillment[]

  @@index([createdById])
  @@index([organizationId])
  @@index([requestType])
  @@index([status])
  @@index([pickupLocationId])
  @@index([deliveryLocationId])
}

model TransportRequirement {
  id                      String           @id @default(uuid())
  transportRequestId      String
  transportRequest        TransportRequest @relation(fields: [transportRequestId], references: [id], onDelete: Cascade)
  cargoType               String           // "Cotton", "Neem Urea Bags", "Paddy", "Spraying Equipment", "Water"
  quantity                Float            // e.g. 5000.0
  unit                    String           @default("kg") // "kg", "quintals", "bags", "litres"
  vehicleType             VehicleType      @default(TRUCK)
  minimumCapacity         Float            // e.g. 6000.0
  requiredVehicleFeatures String?          // "Tarpaulin Covered", "Drop Side", "High Suspension"
  specialInstructions     String?

  @@index([transportRequestId])
}

model TransportStop {
  id                 String            @id @default(uuid())
  transportRequestId String
  transportRequest   TransportRequest  @relation(fields: [transportRequestId], references: [id], onDelete: Cascade)
  sequence           Int               @default(1)
  stopType           TransportStopType @default(PICKUP)
  locationId         String
  location           Location          @relation(fields: [locationId], references: [id])
  plannedArrival     DateTime?
  plannedDeparture   DateTime?
  actualArrival      DateTime?
  actualDeparture    DateTime?
  status             String            @default("PLANNED") // PLANNED, ARRIVED, DEPARTED, SKIPPED

  @@index([transportRequestId])
  @@index([locationId])
}

model TransportOffer {
  id                 String               @id @default(uuid())
  transportRequestId String
  transportRequest   TransportRequest     @relation(fields: [transportRequestId], references: [id], onDelete: Cascade)
  providerId         String
  provider           User                 @relation("ProviderTransportOffers", fields: [providerId], references: [id], onDelete: Cascade)
  vehicleId          String
  vehicle            Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId           String?
  driver             DriverProfile?       @relation(fields: [driverId], references: [id], onDelete: SetNull)
  price              Float                // Total offered transportation price in INR
  currency           String               @default("INR")
  message            String?
  expiresAt          DateTime
  status             TransportOfferStatus @default(OFFERED)
  submittedAt        DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  booking            TransportBooking?

  @@index([transportRequestId])
  @@index([providerId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([status])
}

model TransportBooking {
  id                 String                 @id @default(uuid())
  referenceCode      String                 @unique // e.g. "TBK-2026-0001"
  transportRequestId String
  transportRequest   TransportRequest       @relation(fields: [transportRequestId], references: [id], onDelete: Cascade)
  offerId            String?                @unique
  offer              TransportOffer?        @relation(fields: [offerId], references: [id], onDelete: SetNull)
  customerId         String
  customer           User                   @relation("CustomerTransportBookings", fields: [customerId], references: [id], onDelete: Cascade)
  providerId         String                 // Provider User ID
  vehicleId          String
  vehicle            Vehicle                @relation(fields: [vehicleId], references: [id])
  driverId           String?
  driver             DriverProfile?         @relation(fields: [driverId], references: [id], onDelete: SetNull)
  priceQuoteId       String?
  status             TransportBookingStatus @default(CONFIRMED)
  scheduledAt        DateTime
  agreedPrice        Float                  // Total agreed trip cost in INR
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  trips              Trip[]

  @@index([transportRequestId])
  @@index([customerId])
  @@index([providerId])
  @@index([vehicleId])
  @@index([status])
}

model Trip {
  id                    String                 @id @default(uuid())
  transportBookingId    String
  transportBooking      TransportBooking       @relation(fields: [transportBookingId], references: [id], onDelete: Cascade)
  startedAt             DateTime               @default(now())
  completedAt           DateTime?
  actualDistanceKm      Float?
  actualDurationMinutes Int?
  status                TripStatus             @default(PLANNED)
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  deliveryConfirmations DeliveryConfirmation[]

  @@index([transportBookingId])
  @@index([status])
}

model DeliveryConfirmation {
  id                String               @id @default(uuid())
  tripId            String
  trip              Trip                 @relation(fields: [tripId], references: [id], onDelete: Cascade)
  confirmedById     String
  confirmedBy       User                 @relation("ConfirmedDeliveries", fields: [confirmedById], references: [id], onDelete: Cascade)
  confirmedAt       DateTime             @default(now())
  quantityDelivered Float                // Actual received quantity
  unit              String               @default("kg")
  evidenceType      DeliveryEvidenceType @default(OTP)
  evidenceData      String?              // Photo URL, document hash, or signature string
  otpCode           String?              // 4-digit verification OTP
  notes             String?

  @@index([tripId])
  @@index([confirmedById])
}

// ----------------------------------------------------
// Milestone 17: Agricultural Knowledge, Advisory & Digital Extension
// ----------------------------------------------------

enum KnowledgeContentType {
  ARTICLE
  GUIDE
  CHECKLIST
  FAQ
  VIDEO
  INFOGRAPHIC
  SAFETY_NOTICE
}

enum KnowledgeStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
  EXPIRED
}

enum KnowledgeReviewStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum AdvisoryType {
  GENERAL
  FARM_ACTIVITY
  CROP_STAGE
  EQUIPMENT
  INPUT
  WEATHER
  MARKETPLACE
  SAFETY
  PROGRAM
}

enum AdvisoryStatus {
  NEW
  VIEWED
  ACKNOWLEDGED
  DISMISSED
  EXPIRED
}

enum SourceType {
  GOVERNMENT
  AGRICULTURAL_INSTITUTION
  UNIVERSITY
  RESEARCH
  INTERNAL
  EXPERT
  OTHER
}

enum FieldVisitStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum ObservationCategory {
  CROP_HEALTH
  IRRIGATION
  SOIL
  PEST
  DISEASE
  WEED
  EQUIPMENT
  OTHER
}

enum ObservationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum KnowledgeGapStatus {
  OPEN
  IN_REVIEW
  CONTENT_CREATED
  RESOLVED
}

model KnowledgeCategory {
  id          String              @id @default(uuid())
  name        String
  slug        String              @unique
  description String?
  parentId    String?
  parent      KnowledgeCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    KnowledgeCategory[] @relation("CategoryHierarchy")
  status      String              @default("ACTIVE")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  articles    KnowledgeArticle[]

  @@index([slug])
  @@index([parentId])
}

model Crop {
  id             String          @id @default(uuid())
  name           String          @unique // e.g. "Cotton", "Paddy", "Groundnut", "Chilli"
  scientificName String?
  category       String          @default("CASH_CROP") // CEREAL, PULSE, OILSEED, CASH_CROP, HORTICULTURE
  description    String?
  status         String          @default("ACTIVE")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  knowledgeLinks CropKnowledge[]
  activityGuides ActivityGuide[]
  advisories     Advisory[]
  knowledgeGaps  KnowledgeGap[]
}

model KnowledgeArticle {
  id            String               @id @default(uuid())
  title         String
  slug          String               @unique
  summary       String
  content       String               @db.Text
  contentType   KnowledgeContentType @default(ARTICLE)
  status        KnowledgeStatus      @default(DRAFT)
  language      String               @default("en") // Primary language
  categoryId    String?
  category      KnowledgeCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId      String
  author        User                 @relation("AuthoredArticles", fields: [authorId], references: [id], onDelete: Cascade)
  reviewedById  String?
  reviewedBy    User?                @relation("ReviewedArticles", fields: [reviewedById], references: [id], onDelete: SetNull)
  publishedAt   DateTime?
  expiresAt     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  sources              ArticleSource[]
  reviews              KnowledgeReview[]
  versions             KnowledgeArticleVersion[]
  translations         KnowledgeTranslation[]
  cropKnowledge        CropKnowledge[]
  activityGuides       ActivityGuide[]
  observationsAttached FieldObservation[]
  advisoriesAttached   Advisory[]

  @@index([slug])
  @@index([status])
  @@index([contentType])
  @@index([categoryId])
  @@index([language])
}

model CropKnowledge {
  id           String           @id @default(uuid())
  cropId       String
  crop         Crop             @relation(fields: [cropId], references: [id], onDelete: Cascade)
  articleId    String
  article      KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  stage        String?          // e.g. "LAND_PREP", "SOWING", "FLOWERING", "BOLL_DEVELOPMENT", "HARVEST"
  activityType String?          // e.g. "SPRAYING", "IRRIGATION", "FERTILIZATION"
  priority     Int              @default(1)
  farmId       String?
  farm         Farm?            @relation(fields: [farmId], references: [id], onDelete: SetNull)

  @@index([cropId])
  @@index([articleId])
  @@index([stage])
}

model ActivityGuide {
  id           String           @id @default(uuid())
  activityType String           // e.g. "SPRAYING", "IRRIGATION", "HARVESTING", "TILLING"
  cropId       String?
  crop         Crop?            @relation(fields: [cropId], references: [id], onDelete: SetNull)
  title        String
  description  String?
  articleId    String
  article      KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  sequence     Int              @default(1)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())

  @@index([activityType])
  @@index([cropId])
}

model KnowledgeSource {
  id           String          @id @default(uuid())
  name         String          // e.g. "PJTSAU Agricultural University"
  organization String          // e.g. "ICAR / PJTSAU / Govt of Telangana"
  sourceType   SourceType      @default(AGRICULTURAL_INSTITUTION)
  reference    String?         // DOI, Bulletin number, Circular ID
  description  String?
  status       String          @default("VERIFIED")
  createdAt    DateTime        @default(now())

  articleCitations ArticleSource[]

  @@index([sourceType])
}

model ArticleSource {
  id           String           @id @default(uuid())
  articleId    String
  article      KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  sourceId     String
  source       KnowledgeSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  citationText String           // e.g. "PJTSAU Cotton Package of Practices, Bull. 42 (2025)"
  referenceUrl String?

  @@index([articleId])
  @@index([sourceId])
}

model KnowledgeReview {
  id          String                @id @default(uuid())
  articleId   String
  article     KnowledgeArticle      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  reviewerId  String
  reviewer    User                  @relation("ReviewerReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  status      KnowledgeReviewStatus @default(PENDING)
  comments    String?               @db.Text
  reviewedAt  DateTime              @default(now())

  @@index([articleId])
  @@index([reviewerId])
  @@index([status])
}

model KnowledgeArticleVersion {
  id          String           @id @default(uuid())
  articleId   String
  article     KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  version     Int              @default(1)
  title       String
  content     String           @db.Text
  createdById String
  createdBy   User             @relation("VersionCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())

  @@index([articleId])
  @@index([version])
}

model KnowledgeTranslation {
  id           String           @id @default(uuid())
  articleId    String
  article      KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  language     String           // "te", "hi", "ta", "kn"
  title        String
  summary      String
  content      String           @db.Text
  status       KnowledgeStatus  @default(DRAFT)
  reviewedById String?
  reviewedBy   User?            @relation("ReviewedTranslations", fields: [reviewedById], references: [id], onDelete: SetNull)
  publishedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([articleId])
  @@index([language])
  @@index([status])
}

model Advisory {
  id                String           @id @default(uuid())
  createdForUserId  String
  createdForUser    User             @relation("UserAdvisories", fields: [createdForUserId], references: [id], onDelete: Cascade)
  farmId            String?
  farm              Farm?            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cropId            String?
  crop              Crop?            @relation(fields: [cropId], references: [id], onDelete: SetNull)
  activityId        String?          // e.g. references farm activity or template
  attachedArticleId String?
  attachedArticle   KnowledgeArticle? @relation(fields: [attachedArticleId], references: [id], onDelete: SetNull)
  type              AdvisoryType     @default(GENERAL)
  title             String
  description       String           @db.Text
  priority          String           @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status            AdvisoryStatus   @default(NEW)
  createdAt         DateTime         @default(now())
  expiresAt         DateTime?

  @@index([createdForUserId])
  @@index([farmId])
  @@index([status])
}

model FieldVisit {
  id           String             @id @default(uuid())
  officerId    String
  officer      User               @relation("OfficerFieldVisits", fields: [officerId], references: [id], onDelete: Cascade)
  farmId       String
  farm         Farm               @relation(fields: [farmId], references: [id], onDelete: Cascade)
  visitDate    DateTime           @default(now())
  purpose      String             // e.g. "Pre-harvest boll inspection", "Soil health check"
  notes        String?            @db.Text
  status       FieldVisitStatus   @default(PLANNED)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  observations FieldObservation[]

  @@index([officerId])
  @@index([farmId])
  @@index([status])
}

model FieldObservation {
  id                String              @id @default(uuid())
  fieldVisitId      String
  fieldVisit        FieldVisit          @relation(fields: [fieldVisitId], references: [id], onDelete: Cascade)
  category          ObservationCategory @default(CROP_HEALTH)
  observation       String              @db.Text // Non-diagnosis factual observation
  severity          ObservationSeverity @default(LOW)
  photoReference    String?
  attachedArticleId String?
  attachedArticle   KnowledgeArticle?   @relation(fields: [attachedArticleId], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())

  @@index([fieldVisitId])
  @@index([category])
  @@index([severity])
}

model KnowledgeGap {
  id           String             @id @default(uuid())
  query        String             // Farmer query that yielded zero results
  cropId       String?
  crop         Crop?              @relation(fields: [cropId], references: [id], onDelete: SetNull)
  activityType String?
  locationId   String?
  count        Int                @default(1)
  status       KnowledgeGapStatus @default(OPEN)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([query])
  @@index([status])
}

// ----------------------------------------------------
// 18. Rural Financial Infrastructure & Credit Readiness (Milestone 18)
// ----------------------------------------------------

enum ConsentPurpose {
  FINANCIAL_PROFILE
  CREDIT_ASSESSMENT
  LENDER_DATA_SHARING
  INCOME_VERIFICATION
  TRANSACTION_ANALYSIS
}

enum ConsentStatus {
  PENDING
  GRANTED
  REVOKED
  EXPIRED
}

enum FinancialProfileStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum IncomeSourceType {
  PRODUCE_SALE
  SERVICE_EARNING
  CONTRACTOR_REVENUE
  SUPPLIER_SALE
  OTHER
}

enum ExpenseCategory {
  TRACTOR_SERVICE
  WORKER_SERVICE
  INPUT_PURCHASE
  TRANSPORT
  EQUIPMENT
  OTHER
}

enum RecordStatus {
  RECORDED
  VERIFIED
  RECONCILED
  DISPUTED
  CANCELLED
}

enum CreditIndicatorType {
  TRANSACTION_HISTORY
  INCOME_STABILITY
  SALES_ACTIVITY
  SERVICE_ACTIVITY
  PAYMENT_RELIABILITY
  SETTLEMENT_HISTORY
  PROFILE_VERIFICATION
  DISPUTE_ACTIVITY
}

enum IndicatorRating {
  EXCELLENT
  STRONG
  MODERATE
  LIMITED
  INSUFFICIENT_DATA
}

enum FinancialPartnerType {
  BANK
  NBFC
  COOPERATIVE
  MICROFINANCE
  INSURANCE_PROVIDER
  OTHER_REGULATED_ENTITY
}

enum FinancingPurpose {
  INPUT_PURCHASE
  EQUIPMENT
  TRACTOR
  WORKING_CAPITAL
  CROP_ACTIVITY
  TRANSPORT
  OTHER
}

enum FinancingStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ADDITIONAL_INFO_REQUIRED
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum RepaymentStatus {
  UPCOMING
  DUE
  PAID
  OVERDUE
  WAIVED
}

model FinancialProfile {
  id                   String                 @id @default(uuid())
  userId               String                 @unique
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency             String                 @default("INR")
  profileStatus        FinancialProfileStatus @default(ACTIVE)
  totalIncome          Float                  @default(0.0)
  totalExpense         Float                  @default(0.0)
  netPlatformActivity  Float                  @default(0.0)
  lastCalculatedAt     DateTime               @default(now())
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  incomeRecords        IncomeRecord[]
  expenseRecords       ExpenseRecord[]
  creditProfile        CreditProfile?

  @@index([userId])
  @@index([profileStatus])
}

model IncomeRecord {
  id            String           @id @default(uuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId     String?
  profile       FinancialProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  sourceType    IncomeSourceType @default(PRODUCE_SALE)
  referenceType String?          // e.g. "ProduceOrder", "Settlement", "WorkOffer"
  referenceId   String?
  amount        Float
  currency      String           @default("INR")
  date          DateTime         @default(now())
  status        RecordStatus     @default(RECORDED)
  description   String?
  createdAt     DateTime         @default(now())

  @@index([userId])
  @@index([sourceType])
  @@index([date])
}

model ExpenseRecord {
  id            String           @id @default(uuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId     String?
  profile       FinancialProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  category      ExpenseCategory  @default(TRACTOR_SERVICE)
  referenceType String?          // e.g. "Booking", "InputOrder", "TransportBooking"
  referenceId   String?
  amount        Float
  currency      String           @default("INR")
  date          DateTime         @default(now())
  status        RecordStatus     @default(RECORDED)
  description   String?
  createdAt     DateTime         @default(now())

  @@index([userId])
  @@index([category])
  @@index([date])
}

model FarmFinancialPeriod {
  id           String    @id @default(uuid())
  farmId       String
  farm         Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  seasonName   String    // e.g. "Kharif 2025-26", "Rabi 2025-26"
  cropName     String
  startDate    DateTime
  endDate      DateTime?
  totalIncome  Float     @default(0.0)
  totalExpense Float     @default(0.0)
  netMargin    Float     @default(0.0)
  status       String    @default("ACTIVE") // ACTIVE, CLOSED
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([farmId])
  @@index([seasonName])
}

model FinancialConsent {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose      ConsentPurpose @default(CREDIT_ASSESSMENT)
  scope        String         // JSON string of granted scopes: ["TRANSACTIONS", "PRODUCE_SALES", "EARNINGS"]
  status       ConsentStatus  @default(GRANTED)
  partnerId    String?
  partner      FinancialPartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  grantedAt    DateTime       @default(now())
  revokedAt    DateTime?
  expiresAt    DateTime
  version      Int            @default(1)
  auditLog     String?        @db.Text

  applications FinancingApplication[]

  @@index([userId])
  @@index([status])
  @@index([partnerId])
}

model CreditProfile {
  id                   String           @id @default(uuid())
  userId               String           @unique
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  financialProfileId   String?          @unique
  financialProfile     FinancialProfile? @relation(fields: [financialProfileId], references: [id], onDelete: SetNull)
  status               String           @default("ACTIVE")
  overallGrade         IndicatorRating  @default(STRONG)
  summaryNotes         String?          @db.Text
  lastCalculatedAt     DateTime         @default(now())
  version              Int              @default(1)

  indicators           CreditIndicator[]

  @@index([userId])
  @@index([overallGrade])
}

model CreditIndicator {
  id              String              @id @default(uuid())
  creditProfileId String
  creditProfile   CreditProfile       @relation(fields: [creditProfileId], references: [id], onDelete: Cascade)
  indicatorType   CreditIndicatorType
  rating          IndicatorRating     @default(STRONG)
  valueScore      Float               @default(85.0) // 0 - 100 benchmark
  rationale       String
  dataSource      String              // e.g. "Platform verified transactions"
  calculatedAt    DateTime            @default(now())

  @@index([creditProfileId])
  @@index([indicatorType])
}

model FinancialPartner {
  id                 String               @id @default(uuid())
  partnerType        FinancialPartnerType @default(BANK)
  name               String               // e.g. "State Bank of India (Agri Division)"
  registrationNumber String?
  verificationStatus VerificationStatus   @default(VERIFIED)
  status             String               @default("ACTIVE")
  apiEndpoint        String?
  contactEmail       String?
  createdAt          DateTime             @default(now())

  consents           FinancialConsent[]
  products           FinancingProduct[]
  requests           FinancingRequest[]
  applications       FinancingApplication[]

  @@index([partnerType])
  @@index([verificationStatus])
}

model FinancingProduct {
  id                     String           @id @default(uuid())
  partnerId              String
  partner                FinancialPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name                   String           // e.g. "Kisan Agri Working Capital"
  code                   String           @unique
  purpose                FinancingPurpose @default(WORKING_CAPITAL)
  minAmount              Float            @default(10000)
  maxAmount              Float            @default(500000)
  currency               String           @default("INR")
  minTenureMonths        Int              @default(3)
  maxTenureMonths        Int              @default(36)
  indicativeInterestRate Float            @default(7.5) // Indicative annual interest %
  status                 String           @default("ACTIVE")
  createdAt              DateTime         @default(now())

  applications           FinancingApplication[]

  @@index([partnerId])
  @@index([purpose])
}

model FinancingRequest {
  id                    String            @id @default(uuid())
  userId                String
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  partnerId             String?
  partner               FinancialPartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  purpose               FinancingPurpose  @default(INPUT_PURCHASE)
  requestedAmount       Float
  currency              String            @default("INR")
  requestedTenureMonths Int               @default(12)
  status                FinancingStatus   @default(DRAFT)
  farmId                String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  application           FinancingApplication?

  @@index([userId])
  @@index([status])
  @@index([partnerId])
}

model FinancingApplication {
  id                   String           @id @default(uuid())
  financingRequestId   String           @unique
  financingRequest     FinancingRequest @relation(fields: [financingRequestId], references: [id], onDelete: Cascade)
  productId            String
  product              FinancingProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  partnerId            String
  partner              FinancialPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  consentId            String
  consent              FinancialConsent @relation(fields: [consentId], references: [id], onDelete: Cascade)
  applicationNumber    String           @unique
  submittedAt          DateTime         @default(now())
  status               FinancingStatus  @default(SUBMITTED)
  externalReference    String?
  approvedAmount       Float?
  interestRatePerAnnum Float?
  tenureMonths         Int?
  decisionNotes        String?          @db.Text

  repayments           FinancingRepayment[]

  @@index([partnerId])
  @@index([status])
  @@index([applicationNumber])
}

model FinancingRepayment {
  id                String               @id @default(uuid())
  applicationId     String
  application       FinancingApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  installmentNumber Int
  dueDate           DateTime
  amount            Float
  currency          String               @default("INR")
  status            RepaymentStatus      @default(UPCOMING)
  paidAt            DateTime?
  externalReference String?
  receiptUrl        String?

  @@index([applicationId])
  @@index([status])
}

// ----------------------------------------------------
// 19. Rural Workforce, Jobs & Skill Marketplace (Milestone 19)
// ----------------------------------------------------

enum EmploymentType {
  DAILY_WAGE
  HOURLY
  SEASONAL
  CONTRACT
  PART_TIME
  FULL_TIME
  PROJECT_BASED
}

enum WorkerAvailabilityStatus {
  AVAILABLE
  BUSY
  UNAVAILABLE
  LOOKING_FOR_WORK
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum CertificationVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum JobType {
  AGRICULTURAL_LABOR
  HARVESTING
  SOWING
  SPRAYING
  IRRIGATION
  TRACTOR_OPERATION
  MACHINERY_OPERATION
  MACHINERY_REPAIR
  DRIVING
  CONSTRUCTION
  ELECTRICAL
  PLUMBING
  WELDING
  GENERAL_LABOR
  OTHER
}

enum JobPayType {
  DAILY
  HOURLY
  FIXED_PROJECT
  PER_ACRE
  PER_UNIT
  NEGOTIABLE
}

enum JobPostingStatus {
  DRAFT
  PUBLISHED
  APPLICATIONS_OPEN
  SHORTLISTING
  STAFFING
  READY
  IN_PROGRESS
  COMPLETED
  CLOSED
  CANCELLED
  EXPIRED
  DISPUTED
}

enum JobApplicationStatus {
  SUBMITTED
  VIEWED
  SHORTLISTED
  REJECTED
  WITHDRAWN
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum JobOfferStatus {
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

enum JobAssignmentStatus {
  ASSIGNED
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  NO_SHOW
  DISPUTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
}

enum AttendanceVerificationMethod {
  SELF_REPORTED
  CONTRACTOR_CONFIRMED
  OTP
  LOCATION
}

model WorkerCertification {
  id                  String                          @id @default(uuid())
  workerId            String
  worker              WorkerProfile                   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  name                String                          // e.g. "Certified Precision Sprayer Operator", "Heavy Tractor Driving License"
  issuingOrganization String                          // e.g. "National Skill Development Corporation (NSDC)", "PJTSAU Agronomy Extension"
  certificateNumber   String?
  issuedDate          DateTime?
  expiryDate          DateTime?
  verificationStatus  CertificationVerificationStatus @default(PENDING)
  documentReference   String?
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt

  @@index([workerId])
  @@index([verificationStatus])
}

model WorkerExperience {
  id               String        @id @default(uuid())
  workerId         String
  worker           WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  jobTitle         String        // e.g. "Lead Harvester Operator", "Senior Sprayer Technician"
  organizationName String        // e.g. "Sri Sai Agri Contracting", "Tangipalli FPO"
  description      String?       @db.Text
  startDate        DateTime
  endDate          DateTime?
  isCurrent        Boolean       @default(false)
  createdAt        DateTime      @default(now())

  @@index([workerId])
}

model JobPosting {
  id              String           @id @default(uuid())
  createdById     String
  createdBy       User             @relation("CreatedJobPostings", fields: [createdById], references: [id], onDelete: Cascade)
  organizationId  String?
  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  projectId       String?
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  farmId          String?
  farm            Farm?            @relation(fields: [farmId], references: [id], onDelete: SetNull)
  farmActivityId  String?
  title           String           // e.g. "Cotton Harvesting Workers (50 Acres)", "Tractor & Rotavator Operator"
  description     String?          @db.Text
  jobType         JobType          @default(AGRICULTURAL_LABOR)
  locationId      String?
  location        Location?        @relation(fields: [locationId], references: [id])
  startDate       DateTime
  endDate         DateTime?
  startTime       String           @default("07:00")
  endTime         String           @default("17:00")
  workersRequired Int              @default(1)
  payType         JobPayType       @default(DAILY)
  minPay          Float            @default(500.0)
  maxPay          Float            @default(800.0)
  currency        String           @default("INR")
  status          JobPostingStatus @default(DRAFT)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  requirements    JobRequirement[]
  applications    JobApplication[]
  offers          JobOffer[]
  assignments     JobAssignment[]

  @@index([createdById])
  @@index([organizationId])
  @@index([projectId])
  @@index([farmId])
  @@index([status])
  @@index([jobType])
}

model JobRequirement {
  id                    String        @id @default(uuid())
  jobPostingId          String
  jobPosting            JobPosting    @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  resourceType          ResourceType  @default(WORKER)
  quantity              Int           @default(1)
  skillId               String?
  skill                 Skill?        @relation(fields: [skillId], references: [id], onDelete: SetNull)
  skillLevel            SkillLevel?   @default(INTERMEDIATE)
  minExperienceYears    Int?          @default(1)
  certificationRequired Boolean       @default(false)
  equipmentRequired     Boolean       @default(false)
  notes                 String?

  @@index([jobPostingId])
  @@index([skillId])
}

model JobApplication {
  id           String               @id @default(uuid())
  jobPostingId String
  jobPosting   JobPosting           @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  workerId     String
  worker       WorkerProfile        @relation(fields: [workerId], references: [id], onDelete: Cascade)
  message      String?              @db.Text
  expectedPay  Float?
  status       JobApplicationStatus @default(SUBMITTED)
  appliedAt    DateTime             @default(now())
  reviewedAt   DateTime?

  assignments  JobAssignment[]

  @@unique([jobPostingId, workerId])
  @@index([jobPostingId])
  @@index([workerId])
  @@index([status])
}

model JobOffer {
  id           String         @id @default(uuid())
  jobPostingId String
  jobPosting   JobPosting     @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  workerId     String
  worker       WorkerProfile  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User           @relation("CreatedJobOffers", fields: [createdById], references: [id], onDelete: Cascade)
  payAmount    Float
  payType      JobPayType     @default(DAILY)
  startDate    DateTime
  endDate      DateTime?
  message      String?        @db.Text
  expiresAt    DateTime?
  status       JobOfferStatus @default(OFFERED)
  createdAt    DateTime       @default(now())

  assignments  JobAssignment[]

  @@index([jobPostingId])
  @@index([workerId])
  @@index([createdById])
  @@index([status])
}

model JobAssignment {
  id               String              @id @default(uuid())
  jobPostingId     String
  jobPosting       JobPosting          @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  workerId         String
  worker           WorkerProfile       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  jobApplicationId String?
  jobApplication   JobApplication?     @relation(fields: [jobApplicationId], references: [id], onDelete: SetNull)
  jobOfferId       String?
  jobOffer         JobOffer?           @relation(fields: [jobOfferId], references: [id], onDelete: SetNull)
  startDate        DateTime
  endDate          DateTime?
  payAmount        Float
  payType          JobPayType          @default(DAILY)
  status           JobAssignmentStatus @default(ASSIGNED)
  assignedAt       DateTime            @default(now())
  completedAt      DateTime?

  attendanceRecords AttendanceRecord[]
  workHistories     WorkerWorkHistory[]

  @@index([jobPostingId])
  @@index([workerId])
  @@index([status])
}

model AttendanceRecord {
  id                 String                       @id @default(uuid())
  assignmentId       String
  assignment         JobAssignment                @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  workerId           String
  worker             WorkerProfile                @relation(fields: [workerId], references: [id], onDelete: Cascade)
  date               DateTime
  checkInAt          DateTime?
  checkOutAt         DateTime?
  status             AttendanceStatus             @default(PRESENT)
  locationId         String?
  location           Location?                    @relation(fields: [locationId], references: [id])
  verificationMethod AttendanceVerificationMethod @default(CONTRACTOR_CONFIRMED)
  notes              String?
  createdAt          DateTime                     @default(now())

  @@index([assignmentId])
  @@index([workerId])
  @@index([date])
}

model WorkerWorkHistory {
  id               String         @id @default(uuid())
  workerId         String
  worker           WorkerProfile  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  jobAssignmentId  String?
  jobAssignment    JobAssignment? @relation(fields: [jobAssignmentId], references: [id], onDelete: SetNull)
  jobTitle         String         // e.g. "Cotton Harvesting Operator"
  organizationName String         // e.g. "Tangipalli FPO"
  startDate        DateTime
  endDate          DateTime?
  totalHours       Float          @default(8.0)
  totalDays        Float          @default(1.0)
  earnings         Float          @default(0.0)
  currency         String         @default("INR")
  completionStatus String         @default("COMPLETED") // COMPLETED, CANCELLED
  rating           Float?
  createdAt        DateTime       @default(now())

  @@index([workerId])
}

// ----------------------------------------------------
// 20. Rural Asset Rental, Equipment Sharing & Machinery Marketplace (Milestone 20)
// ----------------------------------------------------

enum AssetType {
  TRACTOR
  SPRAYER
  PUMP
  WATER_PUMP
  TRAILER
  ROTAVATOR
  PLOUGH
  CULTIVATOR
  HARROW
  SEED_DRILL
  LAND_LEVELER
  HARVESTER
  IRRIGATION_EQUIPMENT
  THRESHER
  OTHER
}

enum AssetCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  DAMAGED
  NON_FUNCTIONAL
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
  RENTED
  RESERVED
  DAMAGED
  RETIRED
  SUSPENDED
}

enum RentalMode {
  EQUIPMENT_ONLY
  EQUIPMENT_WITH_OPERATOR
  EQUIPMENT_WITH_DELIVERY
  EQUIPMENT_OPERATOR_DELIVERY
}

enum AssetPricingModel {
  PER_HOUR
  PER_DAY
  PER_ACRE
  PER_TRIP
  PER_UNIT
  FIXED
  NEGOTIABLE
}

enum DepositStatus {
  NOT_REQUIRED
  PENDING
  HELD
  PARTIALLY_REFUNDED
  REFUNDED
  PARTIALLY_FORFEITED
  FORFEITED
}

enum RentalRequestStatus {
  DRAFT
  OPEN
  MATCHED
  OFFER_RECEIVED
  BOOKED
  CANCELLED
  EXPIRED
}

enum RentalOfferStatus {
  OFFERED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum RentalBookingStatus {
  CONFIRMED
  READY
  HANDED_OVER
  IN_USE
  RETURN_PENDING
  RETURNED
  INSPECTED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum HandoverStatus {
  PENDING
  COMPLETED
  DISPUTED
}

enum AssetInspectionType {
  PRE_RENTAL
  POST_RENTAL
  DAMAGE
  MAINTENANCE
}

enum AssetInspectionCondition {
  GOOD
  MINOR_DAMAGE
  MAJOR_DAMAGE
  NON_FUNCTIONAL
}

enum MaintenanceType {
  ROUTINE_SERVICE
  REPAIR
  OIL_CHANGE
  TYRE_REPLACEMENT
  ENGINE_SERVICE
  INSPECTION
  OTHER
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AssetAccessType {
  PUBLIC_RENTAL
  MEMBERS_ONLY
  APPROVAL_REQUIRED
  INTERNAL_ONLY
}

model Asset {
  id                  String             @id @default(uuid())
  ownerId             String
  owner               User               @relation("UserOwnedAssets", fields: [ownerId], references: [id], onDelete: Cascade)
  organizationId      String?
  organization        Organization?      @relation("OrganizationAssets", fields: [organizationId], references: [id], onDelete: SetNull)
  assetType           AssetType          @default(TRACTOR)
  name                String             // e.g. "John Deere 5050D Tractor"
  brand               String             // e.g. "John Deere"
  model               String             // e.g. "5050D PowerPro"
  serialNumber        String?
  registrationNumber  String?
  manufacturingYear   Int?
  capacity            Float?             // e.g. 50 (HP) or 500 (Litres) or 5 (HP pump)
  capacityUnit        String?            // "HP", "LITRE", "INCH", "TON"
  condition           AssetCondition     @default(GOOD)
  status              AssetStatus        @default(ACTIVE)
  baseLocationId      String
  baseLocation        Location           @relation("AssetBaseLocation", fields: [baseLocationId], references: [id])
  description         String?
  hourlyRate          Float?
  dailyRate           Float?
  rating              Float              @default(0.0)
  totalRentals        Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  specifications      AssetSpecification[]
  attachments         AssetAttachment[]  @relation("ParentAsset")
  attachedTo          AssetAttachment[]  @relation("ChildAttachment")
  rentalListings      RentalListing[]
  rentalOffers        RentalOffer[]
  rentalBookings      RentalBooking[]
  handovers           AssetHandover[]
  inspections         AssetInspection[]
  maintenanceRecords  MaintenanceRecord[]
  accessPolicies      AssetAccessPolicy[]

  @@index([ownerId])
  @@index([organizationId])
  @@index([assetType])
  @@index([status])
  @@index([baseLocationId])
}

model AssetSpecification {
  id        String   @id @default(uuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  key       String   // e.g. "hp", "fuelType", "pipeDiameter", "tankCapacity"
  value     String   // e.g. "55", "DIESEL", "3", "500"
  unit      String?  // e.g. "HP", "INCH", "LITRE"
  createdAt DateTime @default(now())

  @@index([assetId])
  @@index([key])
}

model AssetAttachment {
  id                 String          @id @default(uuid())
  assetId            String
  asset              Asset           @relation("ParentAsset", fields: [assetId], references: [id], onDelete: Cascade)
  attachmentAssetId  String?
  attachmentAsset    Asset?          @relation("ChildAttachment", fields: [attachmentAssetId], references: [id], onDelete: SetNull)
  attachmentType     AttachmentType  @default(ROTAVATOR)
  compatible         Boolean         @default(true)
  notes              String?
  createdAt          DateTime        @default(now())

  @@index([assetId])
  @@index([attachmentAssetId])
}

model RentalListing {
  id                String            @id @default(uuid())
  assetId           String
  asset             Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  ownerId           String
  owner             User              @relation("UserRentalListings", fields: [ownerId], references: [id], onDelete: Cascade)
  title             String            // e.g. "50 HP Tractor with Operator & Rotavator"
  description       String?
  rentalMode        RentalMode        @default(EQUIPMENT_ONLY)
  pricingModel      AssetPricingModel @default(PER_DAY)
  price             Float             // e.g. 4500.0 (Daily rate)
  currency          String            @default("INR")
  minimumDuration   Int               @default(1) // e.g. 1 (Day or Hour)
  maximumDuration   Int?
  requiresOperator  Boolean           @default(false)
  deliveryAvailable Boolean           @default(false)
  pickupAvailable   Boolean           @default(true)
  securityDeposit   Float?            @default(0.0)
  status            String            @default("ACTIVE") // ACTIVE, PAUSED, ARCHIVED
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([assetId])
  @@index([ownerId])
  @@index([rentalMode])
  @@index([status])
}

model RentalDeposit {
  id               String         @id @default(uuid())
  rentalBookingId  String         @unique
  rentalBooking    RentalBooking  @relation(fields: [rentalBookingId], references: [id], onDelete: Cascade)
  amount           Float          // e.g. 2000.0
  currency         String         @default("INR")
  status           DepositStatus  @default(NOT_REQUIRED)
  paymentId        String?
  refundedAmount   Float          @default(0.0)
  forfeitedAmount  Float          @default(0.0)
  reason           String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status])
}

model RentalRequest {
  id           String              @id @default(uuid())
  createdById  String
  createdBy    User                @relation("UserRentalRequests", fields: [createdById], references: [id], onDelete: Cascade)
  assetType    AssetType           @default(TRACTOR)
  locationId   String
  location     Location            @relation("RentalRequestLocation", fields: [locationId], references: [id])
  startDate    DateTime
  endDate      DateTime?
  startTime    String?             // e.g. "07:00"
  endTime      String?             // e.g. "18:00"
  rentalMode   RentalMode          @default(EQUIPMENT_ONLY)
  quantity     Int                 @default(1)
  requirements Json?               // JSON metadata: { "minHp": 50, "attachment": "ROTAVATOR", "operatorNeeded": true }
  status       RentalRequestStatus @default(OPEN)
  createdAt    DateTime            @default(now())

  offers       RentalOffer[]
  bookings     RentalBooking[]

  @@index([createdById])
  @@index([assetType])
  @@index([status])
}

model RentalOffer {
  id               String            @id @default(uuid())
  rentalRequestId  String
  rentalRequest    RentalRequest     @relation(fields: [rentalRequestId], references: [id], onDelete: Cascade)
  assetId          String
  asset            Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  providerId       String
  provider         User              @relation("ProviderRentalOffers", fields: [providerId], references: [id], onDelete: Cascade)
  operatorId       String?
  priceQuoteId     String?
  offeredRate      Float             // e.g. 4200.0 / day
  rentalMode       RentalMode        @default(EQUIPMENT_ONLY)
  message          String?
  expiresAt        DateTime?
  status           RentalOfferStatus @default(OFFERED)
  createdAt        DateTime          @default(now())

  bookings         RentalBooking[]

  @@index([rentalRequestId])
  @@index([assetId])
  @@index([providerId])
  @@index([status])
}

model RentalBooking {
  id               String              @id @default(uuid())
  rentalRequestId  String?
  rentalRequest    RentalRequest?      @relation(fields: [rentalRequestId], references: [id], onDelete: SetNull)
  rentalOfferId    String?
  rentalOffer      RentalOffer?        @relation(fields: [rentalOfferId], references: [id], onDelete: SetNull)
  assetId          String
  asset            Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  ownerId          String
  owner            User                @relation("OwnerRentalBookings", fields: [ownerId], references: [id], onDelete: Cascade)
  renterId         String
  renter           User                @relation("RenterRentalBookings", fields: [renterId], references: [id], onDelete: Cascade)
  operatorId       String?
  startDate        DateTime
  endDate          DateTime?
  startTime        String?
  endTime          String?
  rentalMode       RentalMode          @default(EQUIPMENT_ONLY)
  totalAmount      Float               @default(0.0)
  priceQuoteId     String?
  status           RentalBookingStatus @default(CONFIRMED)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  deposit          RentalDeposit?
  handovers        AssetHandover[]
  inspections      AssetInspection[]

  @@index([assetId])
  @@index([ownerId])
  @@index([renterId])
  @@index([status])
}

model AssetHandover {
  id               String          @id @default(uuid())
  rentalBookingId  String
  rentalBooking    RentalBooking   @relation(fields: [rentalBookingId], references: [id], onDelete: Cascade)
  assetId          String
  asset            Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  handedOverById   String
  handedOverBy     User            @relation("HandoverGiver", fields: [handedOverById], references: [id], onDelete: Cascade)
  receivedById     String
  receivedBy       User            @relation("HandoverReceiver", fields: [receivedById], references: [id], onDelete: Cascade)
  handoverAt       DateTime        @default(now())
  condition        AssetCondition  @default(GOOD)
  fuelLevel        Float?          // 0 to 100%
  meterReading     Float?          // Hours or KM
  notes            String?
  status           HandoverStatus  @default(COMPLETED)
  createdAt        DateTime        @default(now())

  @@index([rentalBookingId])
  @@index([assetId])
}

model AssetInspection {
  id                 String                   @id @default(uuid())
  rentalBookingId    String?
  rentalBooking      RentalBooking?           @relation(fields: [rentalBookingId], references: [id], onDelete: SetNull)
  assetId            String
  asset              Asset                    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  inspectionType     AssetInspectionType      @default(PRE_RENTAL)
  inspectedById      String
  inspectedBy        User                     @relation("AssetInspectedBy", fields: [inspectedById], references: [id], onDelete: Cascade)
  condition          AssetInspectionCondition @default(GOOD)
  meterReading       Float?
  fuelLevel          Float?
  damageReported     Boolean                  @default(false)
  damageCostEstimate Float?                   @default(0.0)
  notes              String?
  createdAt          DateTime                 @default(now())

  @@index([rentalBookingId])
  @@index([assetId])
  @@index([inspectedById])
}

model MaintenanceRecord {
  id                String            @id @default(uuid())
  assetId           String
  asset             Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  maintenanceType   MaintenanceType   @default(ROUTINE_SERVICE)
  description       String
  serviceProviderId String?
  cost              Float             @default(0.0)
  currency          String            @default("INR")
  performedAt       DateTime          @default(now())
  nextDueAt         DateTime?
  meterReading      Float?
  status            MaintenanceStatus @default(COMPLETED)
  createdAt         DateTime          @default(now())

  @@index([assetId])
  @@index([maintenanceType])
  @@index([status])
}

model AssetAccessPolicy {
  id                 String          @id @default(uuid())
  assetId            String
  asset              Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  organizationId     String
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accessType         AssetAccessType @default(PUBLIC_RENTAL)
  memberEligibility  String?         // e.g. "ALL_MEMBERS", "GOLD_TIER_FARMERS"
  pricingRuleId      String?
  approvalRequired   Boolean         @default(false)
  status             String          @default("ACTIVE")
  createdAt          DateTime        @default(now())

  @@index([assetId])
  @@index([organizationId])
  @@index([accessType])
}

// ----------------------------------------------------
// 21. Rural Commerce & Local Business Marketplace (Milestone 21)
// ----------------------------------------------------

enum BusinessType {
  AGRI_INPUT_SHOP
  MACHINERY_DEALER
  SPARE_PARTS_SHOP
  REPAIR_SHOP
  MECHANIC
  ELECTRICAL_SERVICE
  PLUMBING_SERVICE
  WELDING_SERVICE
  FABRICATION
  CONSTRUCTION
  TRANSPORT
  EQUIPMENT_REPAIR
  GENERAL_RETAIL
  LOCAL_SERVICE
  OTHER
}

enum CommerceProductCategory {
  TOOLS
  HARDWARE
  SPARE_PARTS
  ELECTRICAL
  PLUMBING
  CONSTRUCTION
  FARM_EQUIPMENT
  MACHINERY_PARTS
  SAFETY
  PACKAGING
  HOUSEHOLD
  GENERAL
  OTHER
}

enum ServicePricingModel {
  FIXED
  PER_HOUR
  PER_DAY
  PER_VISIT
  PER_UNIT
  INSPECTION_FIRST
  NEGOTIABLE
}

enum CommerceOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum FulfillmentMethod {
  PICKUP
  LOCAL_DELIVERY
  THIRD_PARTY_LOGISTICS
}

enum InventoryTransactionType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  RESERVATION
  RELEASE
  RETURN
  DAMAGED
}

enum CommerceQuoteStatus {
  DRAFT
  SUBMITTED
  COUNTERED
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum EnquiryStatus {
  OPEN
  QUOTED
  RESOLVED
  CLOSED
}

model BusinessProfile {
  id                 String             @id @default(uuid())
  ownerId            String
  owner              User               @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  organizationId     String?
  organization       Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  businessName       String             // e.g. "Sri Sai Agro Machinery & Spare Parts"
  businessType       BusinessType       @default(GENERAL_RETAIL)
  description        String?
  phone              String
  email              String?
  locationId         String
  location           Location           @relation(fields: [locationId], references: [id])
  serviceRadiusKm    Float              @default(15.0)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  rating             Float              @default(5.0)
  totalReviews       Int                @default(0)
  status             String             @default("ACTIVE")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  locations          BusinessLocation[]
  products           BusinessProduct[]
  services           ServiceListing[]
  orders             CommerceOrder[]    @relation("SellerBusinessOrders")
  enquiries          ProductEnquiry[]
  quotes             CommerceQuote[]

  @@index([ownerId])
  @@index([organizationId])
  @@index([locationId])
  @@index([businessType])
  @@index([status])
}

model BusinessLocation {
  id           String          @id @default(uuid())
  businessId   String
  business     BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String          // e.g. "Main Shop", "Tandur Market Branch"
  locationId   String
  location     Location        @relation(fields: [locationId], references: [id])
  phone        String?
  openingTime  String          @default("08:00")
  closingTime  String          @default("20:00")
  isPrimary    Boolean         @default(true)
  status       String          @default("ACTIVE")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  products     BusinessProduct[]

  @@index([businessId])
  @@index([locationId])
}

model CommerceProduct {
  id               String                  @id @default(uuid())
  name             String                  // e.g. "John Deere Spin-on Oil Filter", "3-inch Heavy Delivery Hose"
  description      String?
  category         CommerceProductCategory @default(GENERAL)
  brand            String?
  model            String?
  sku              String?
  unit             String                  @default("PIECE") // PIECE, METER, SET, BOX, KG, LITRE
  status           String                  @default("ACTIVE")
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  compatibilities  ProductCompatibility[]
  businessProducts BusinessProduct[]
  enquiries        ProductEnquiry[]

  @@index([category])
  @@index([brand])
  @@index([status])
}

model BusinessProduct {
  id                   String                 @id @default(uuid())
  businessId           String
  business             BusinessProfile        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessLocationId   String?
  businessLocation     BusinessLocation?      @relation(fields: [businessLocationId], references: [id], onDelete: SetNull)
  productId            String
  product              CommerceProduct        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                  String?
  price                Float                  // Selling price in INR
  currency             String                 @default("INR")
  stockQuantity        Int                    @default(0)
  reservedQuantity     Int                    @default(0)
  minimumOrderQuantity Int                    @default(1)
  status               String                 @default("ACTIVE")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  inventoryTransactions InventoryTransaction[]
  orderItems           CommerceOrderItem[]

  @@index([businessId])
  @@index([businessLocationId])
  @@index([productId])
  @@index([status])
}

model ProductCompatibility {
  id          String           @id @default(uuid())
  productId   String
  product     CommerceProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  assetType   AssetType?       // TRACTOR, SPRAYER, PUMP, HARVESTER, TRAILER
  brand       String?          // e.g. "John Deere", "Mahindra", "Kirloskar"
  model       String?          // e.g. "5050D", "575 DI", "KDS-750"
  variant     String?
  notes       String?
  createdAt   DateTime         @default(now())

  @@index([productId])
  @@index([assetType, brand, model])
}

model InventoryTransaction {
  id                String                   @id @default(uuid())
  businessProductId String
  businessProduct   BusinessProduct          @relation(fields: [businessProductId], references: [id], onDelete: Cascade)
  type              InventoryTransactionType
  quantity          Int                      // positive for stock in/release, negative for stock out/reservation
  referenceType     String?                  // "COMMERCE_ORDER", "MANUAL_ADJUSTMENT", "PURCHASE_RECEIPT"
  referenceId       String?
  notes             String?
  createdAt         DateTime                 @default(now())

  @@index([businessProductId])
  @@index([type])
  @@index([createdAt])
}

model ServiceCategory {
  id          String            @id @default(uuid())
  name        String            // e.g. "Tractor Engine Repair", "Submersible Pump Service", "Welding & Fabrication"
  description String?
  parentId    String?
  parent      ServiceCategory?  @relation("ServiceCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    ServiceCategory[] @relation("ServiceCategoryHierarchy")
  status      String            @default("ACTIVE")
  createdAt   DateTime          @default(now())

  listings    ServiceListing[]

  @@index([parentId])
  @@index([status])
}

model ServiceListing {
  id                  String              @id @default(uuid())
  businessId          String
  business            BusinessProfile     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId          String
  category            ServiceCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title               String
  description         String?
  pricingModel        ServicePricingModel @default(FIXED)
  basePrice           Float?              // e.g. 500.0 (Fixed or Base Visit)
  hourlyRate          Float?              // e.g. 150.0 / hour
  inspectionFee       Float?              @default(0.0)
  currency            String              @default("INR")
  serviceRadiusKm     Float               @default(20.0)
  locationId          String?
  location            Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  requiresAppointment Boolean             @default(true)
  status              String              @default("ACTIVE")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([businessId])
  @@index([categoryId])
  @@index([status])
}

model ProductEnquiry {
  id         String          @id @default(uuid())
  businessId String
  business   BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  buyerId    String
  buyer      User            @relation("BuyerEnquiries", fields: [buyerId], references: [id], onDelete: Cascade)
  productId  String?
  product    CommerceProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  message    String
  quantity   Int?            @default(1)
  status     EnquiryStatus   @default(OPEN)
  createdAt  DateTime        @default(now())

  quotes     CommerceQuote[]

  @@index([businessId])
  @@index([buyerId])
  @@index([productId])
  @@index([status])
}

model CommerceQuote {
  id           String              @id @default(uuid())
  enquiryId    String?
  enquiry      ProductEnquiry?     @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  businessId   String
  business     BusinessProfile     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  buyerId      String
  buyer        User                @relation("BuyerCommerceQuotes", fields: [buyerId], references: [id], onDelete: Cascade)
  subtotal     Float
  deliveryCost Float               @default(0.0)
  tax          Float               @default(0.0)
  discount     Float               @default(0.0)
  total        Float
  currency     String              @default("INR")
  validUntil   DateTime?
  status       CommerceQuoteStatus @default(SUBMITTED)
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  orders       CommerceOrder[]

  @@index([enquiryId])
  @@index([businessId])
  @@index([buyerId])
  @@index([status])
}

model CommerceOrder {
  id                   String              @id @default(uuid())
  orderNumber          String              @unique // e.g. "ORD-2026-0001"
  buyerId              String
  buyer                User                @relation("BuyerCommerceOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerBusinessId     String
  sellerBusiness       BusinessProfile     @relation("SellerBusinessOrders", fields: [sellerBusinessId], references: [id], onDelete: Cascade)
  quoteId              String?
  quote                CommerceQuote?      @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  fulfillmentMethod    FulfillmentMethod   @default(PICKUP)
  deliveryLocationId   String?
  subtotal             Float
  deliveryCost         Float               @default(0.0)
  tax                  Float               @default(0.0)
  discount             Float               @default(0.0)
  total                Float
  currency             String              @default("INR")
  status               CommerceOrderStatus @default(PENDING)
  paymentId            String?
  transportBookingId   String?
  orderedAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  items                CommerceOrderItem[]

  @@index([buyerId])
  @@index([sellerBusinessId])
  @@index([status])
  @@index([orderNumber])
}

model CommerceOrderItem {
  id                String          @id @default(uuid())
  orderId           String
  order             CommerceOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  businessProductId String
  businessProduct   BusinessProduct @relation(fields: [businessProductId], references: [id], onDelete: Cascade)
  quantity          Int
  unit              String          @default("PIECE")
  unitPrice         Float
  totalAmount       Float
  createdAt         DateTime        @default(now())

  @@index([orderId])
  @@index([businessProductId])
}

